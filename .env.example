# Local worker only. Replace paths; never put this file's populated copy in Git.
CODEX_BINARY_PATH=/absolute/path/to/static/codex
CODEX_AUTH_FILE=/absolute/path/to/codex/auth.json
# A trusted image digest. Container entrypoint is always the mounted static CLI.
CODEX_IMAGE=trusted-image@sha256:replace-with-verified-digest
MODEL_ID=gpt-6.1-sol
MODEL_WORKER_BASE_URL=https://your-torob-app.example
MODEL_WORKER_TOKEN=replace-with-owner-generated-random-256-bit-secret
MODEL_WORKER_LOOPBACK_TEST=0
PYTHONPATH=backend
PUBLIC_ORIGIN=http://127.0.0.1:8651
SESSION_SECRET=replace-with-a-different-random-256-bit-secret
CATALOGUE_DB_PATH=data/catalogue.sqlite
STATE_DB_PATH=data/development.sqlite
